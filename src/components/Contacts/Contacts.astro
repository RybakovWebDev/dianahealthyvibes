---
import styles from "./Contacts.module.css";
import type { LanguageCode } from "../../types";

import { Contacts_Text } from "../../constantsText";
import { socialMediaLinks } from "../../constants.ts";

interface Props {
  locale: LanguageCode;
}

const { locale = "en" } = Astro.props;
---

<section id="contacts" class={styles.wrapper}>
  <div class={styles.innerWrapper}>
    <h2>{Contacts_Text.title[locale]}</h2>
    <a href="tel:+79856455044" class={styles.phoneLink}>
      {Contacts_Text.phoneNumber}
    </a>
    <a href="mailto:diana.gurvich.nutri@gmail.com" class={styles.emailLink}>
      {Contacts_Text.email}
    </a>
    <ul>
      {
        socialMediaLinks.map((socialMedia) => (
          <li>
            <a
              href={socialMedia.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={socialMedia.name}
              title={socialMedia.name}
            >
              <span set:html={socialMedia.icon} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
